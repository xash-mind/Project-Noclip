#!/usr/bin/env bash
set -euo pipefail
python3 - <<'PY'
from pathlib import Path

policy = Path('src/renderer/streamingPolicy.ts')
if policy.exists():
    raise SystemExit('streamingPolicy.ts unexpectedly already exists')
policy.write_text(r'''export const STREAMING_SCHEDULER_PROFILE = Object.freeze({
  workBudgetMs: 2.25,
  maxHeavyJobsPerFrame: 1,
  unloadGraceMs: 1200,
  predictiveExtraRings: 1,
  maxQueueDepth: 256
});

export type StreamingRetentionDisposition = 'active' | 'retained' | 'unload';
export function streamingRetentionDisposition(distance: number, loadRadius: number, retentionRadius: number): StreamingRetentionDisposition {
  if (distance <= loadRadius) return 'active';
  if (distance <= retentionRadius) return 'retained';
  return 'unload';
}

export interface WarmCoordinate { x: number; z: number; priority: number; }
export function predictiveWarmCoordinates(
  centerX: number,
  centerZ: number,
  loadRadius: number,
  directionX: number,
  directionZ: number
): WarmCoordinate[] {
  if (Math.hypot(directionX, directionZ) < 0.08) return [];
  const retentionRadius = loadRadius + STREAMING_SCHEDULER_PROFILE.predictiveExtraRings;
  const length = Math.hypot(directionX, directionZ) || 1;
  const nx = directionX / length;
  const nz = directionZ / length;
  const result = new Map<string, WarmCoordinate>();
  const add = (x: number, z: number, priority: number): void => {
    const id = `${x}:${z}`;
    const existing = result.get(id);
    if (!existing || priority < existing.priority) result.set(id, { x, z, priority });
  };
  if (Math.abs(nx) >= 0.2) {
    const x = centerX + Math.sign(nx) * retentionRadius;
    for (let offset = -loadRadius; offset <= loadRadius; offset += 1) add(x, centerZ + offset, 10 + Math.abs(offset));
  }
  if (Math.abs(nz) >= 0.2) {
    const z = centerZ + Math.sign(nz) * retentionRadius;
    for (let offset = -loadRadius; offset <= loadRadius; offset += 1) add(centerX + offset, z, 10 + Math.abs(offset));
  }
  if (Math.abs(nx) >= 0.2 && Math.abs(nz) >= 0.2) {
    add(centerX + Math.sign(nx) * retentionRadius, centerZ + Math.sign(nz) * retentionRadius, 9);
  }
  return [...result.values()].sort((left, right) => left.priority - right.priority || left.x - right.x || left.z - right.z);
}

export function streamingFrameCanRunHeavyWork(heavyOperations: number, heavyMs: number): boolean {
  return heavyOperations < STREAMING_SCHEDULER_PROFILE.maxHeavyJobsPerFrame
    && heavyMs < STREAMING_SCHEDULER_PROFILE.workBudgetMs;
}
''')

scheduler = Path('src/renderer/streamingScheduler.ts')
text = scheduler.read_text()
start_marker = 'export const STREAMING_SCHEDULER_PROFILE = Object.freeze({'
end_marker = 'interface RenderControl {'
start = text.find(start_marker)
end = text.find(end_marker)
if start < 0 or end < 0 or end <= start:
    raise SystemExit('streamingScheduler.ts: pure-policy block markers not found')
replacement = "import {\n  STREAMING_SCHEDULER_PROFILE,\n  predictiveWarmCoordinates,\n  streamingFrameCanRunHeavyWork\n} from './streamingPolicy.js';\nexport {\n  STREAMING_SCHEDULER_PROFILE,\n  predictiveWarmCoordinates,\n  streamingFrameCanRunHeavyWork,\n  streamingRetentionDisposition\n} from './streamingPolicy.js';\nexport type { StreamingRetentionDisposition, WarmCoordinate } from './streamingPolicy.js';\n\n"
text = text[:start] + replacement + text[end:]
scheduler.write_text(text)

text = scheduler.read_text()
old_helper = "export function streamingFrameCanRunHeavyWork(heavyOperations: number, heavyMs: number): boolean {\n  return heavyOperations < STREAMING_SCHEDULER_PROFILE.maxHeavyJobsPerFrame\n    && heavyMs < STREAMING_SCHEDULER_PROFILE.workBudgetMs;\n}\n\n"
if text.count(old_helper) != 1:
    raise SystemExit(f'streamingScheduler.ts: expected one local admission helper, found {text.count(old_helper)}')
scheduler.write_text(text.replace(old_helper, '', 1))

tsconfig = Path('tsconfig.test.json')
text = tsconfig.read_text()
old = '    "src/renderer/level0RegionPresentation.ts",\n    "src/renderer/renderSettings.ts"\n'
new = '    "src/renderer/level0RegionPresentation.ts",\n    "src/renderer/renderSettings.ts",\n    "src/renderer/streamingPolicy.ts"\n'
if text.count(old) != 1:
    raise SystemExit('tsconfig.test.json: expected renderer include block exactly once')
tsconfig.write_text(text.replace(old, new, 1))

test_path = Path('tests/dev8-corrective.test.mjs')
text = test_path.read_text()
old = "await import('../.test-dist/src/renderer/streamingScheduler.js')"
new = "await import('../.test-dist/src/renderer/streamingPolicy.js')"
if text.count(old) != 1:
    raise SystemExit('dev8-corrective test: expected scheduler import exactly once')
test_path.write_text(text.replace(old, new, 1))

# Existing tests retain scheduler lifecycle/source assertions, but policy
# constants now belong to streamingPolicy.ts.
arch_test = Path('tests/arch-streaming-change.test.mjs')
text = arch_test.read_text()
old = "const streamingSource = await readFile(new URL('../src/renderer/streamingScheduler.ts', import.meta.url), 'utf8');\n"
new = old + "const streamingPolicySource = await readFile(new URL('../src/renderer/streamingPolicy.ts', import.meta.url), 'utf8');\n"
if text.count(old) != 1:
    raise SystemExit('arch-streaming-change: expected streaming source declaration exactly once')
text = text.replace(old, new, 1)
for literal in ('predictiveExtraRings: 1', 'workBudgetMs: 2\\.25', 'maxHeavyJobsPerFrame: 1', 'unloadGraceMs: 1200'):
    old_assert = f'assert.match(streamingSource, /{literal}/);'
    new_assert = f'assert.match(streamingPolicySource, /{literal}/);'
    if text.count(old_assert) != 1:
        raise SystemExit(f'arch-streaming-change: expected policy assertion {old_assert!r}')
    text = text.replace(old_assert, new_assert, 1)
old_assert = 'assert.match(streamingSource, /const retentionRadius = loadRadius \\+ STREAMING_SCHEDULER_PROFILE\\.predictiveExtraRings/);'
new_assert = 'assert.match(streamingPolicySource, /const retentionRadius = loadRadius \\+ STREAMING_SCHEDULER_PROFILE\\.predictiveExtraRings/);'
if text.count(old_assert) != 1:
    raise SystemExit('arch-streaming-change: expected retention policy assertion')
text = text.replace(old_assert, new_assert, 1)
old_assert = 'assert.match(streamingSource, /for \\(let offset = -loadRadius; offset <= loadRadius; offset \\+= 1\\)/);'
new_assert = 'assert.match(streamingPolicySource, /for \\(let offset = -loadRadius; offset <= loadRadius; offset \\+= 1\\)/);'
if text.count(old_assert) != 1:
    raise SystemExit('arch-streaming-change: expected warm-coordinate policy assertion')
arch_test.write_text(text.replace(old_assert, new_assert, 1))

render_test = Path('tests/render-settings.test.mjs')
text = render_test.read_text()
old = "const streamingSource = await readFile(new URL('../src/renderer/streamingScheduler.ts', import.meta.url), 'utf8');\n"
new = old + "const streamingPolicySource = await readFile(new URL('../src/renderer/streamingPolicy.ts', import.meta.url), 'utf8');\n"
if text.count(old) != 1:
    raise SystemExit('render-settings: expected streaming source declaration exactly once')
text = text.replace(old, new, 1)
old_assert = 'assert.match(streamingSource, /unloadGraceMs: 1200/);'
new_assert = 'assert.match(streamingPolicySource, /unloadGraceMs: 1200/);'
if text.count(old_assert) != 1:
    raise SystemExit('render-settings: expected unload grace assertion')
render_test.write_text(text.replace(old_assert, new_assert, 1))
PY
